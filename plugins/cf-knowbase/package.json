{
  "name": "@tenfyzhong/cf-knowbase",
  "version": "0.1.0",
  "description": "Semantic knowledge base search plugin and MCP server for Cloudflare Vectorize.",
  "license": "MIT",
  "omp": {
    "extensions": [
      "./extensions/cf-knowbase-omp.ts"
    ],
    "mcpServers": {
      "cf-knowbase": {
        "command": "node",
        "args": [
          "${PLUGIN_ROOT}/mcp.mjs"
        ]
      }
    }
  },
  "pi": {
    "extensions": [
      "./extensions/cf-knowbase.ts"
    ]
  }
}
