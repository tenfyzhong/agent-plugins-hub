{
  "description": "Export coding-agent usage without delaying lifecycle completion.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AGENT_USAGE_EXPORTER_ROOT=\"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}\"; node \"$AGENT_USAGE_EXPORTER_ROOT/hooks/host-launcher.mjs\" codex",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AGENT_USAGE_EXPORTER_ROOT=\"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}\"; node \"$AGENT_USAGE_EXPORTER_ROOT/hooks/host-launcher.mjs\" claude-code",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
