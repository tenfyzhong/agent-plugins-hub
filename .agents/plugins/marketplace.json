{
  "name": "tenfyzhong-agent-plugins-hub",
  "interface": {
    "displayName": "Agent Plugins Hub"
  },
  "plugins": [
    {
      "name": "lark-cli-skills",
      "source": {
        "source": "local",
        "path": "./plugins/lark-cli-skills"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Productivity"
    },
    {
      "name": "agent-guard",
      "source": {
        "source": "local",
