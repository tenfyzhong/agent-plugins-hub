      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Productivity"
    },
    {
      "name": "agent-notifier",
      "source": {
        "source": "local",
        "path": "./plugins/agent-notifier"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Productivity"
    },
    {
      "name": "engineering-delivery",
      "source": {
        "source": "local",
        "path": "./plugins/engineering-delivery"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Productivity"
    },
    {
      "name": "agent-usage-exporter",
      "source": {
        "source": "local",
